<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Version>0.1.1</Version>
    <AssemblyName>PurposeMechanicsProbe</AssemblyName>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="BepInEx"><HintPath>$(GameRoot)/BepInEx/core/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameRoot)/BepInEx/core/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameRoot)/Graveyard Keeper_Data/Managed/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameRoot)/Graveyard Keeper_Data/Managed/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameRoot)/Graveyard Keeper_Data/Managed/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(GameRoot)/Graveyard Keeper_Data/Managed/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="GenerateProbeVersion" BeforeTargets="CoreCompile">
    <WriteLinesToFile File="$(IntermediateOutputPath)ProbeVersion.g.cs" Lines="internal static class ThisAssemblyVersion { internal const string Value = &quot;$(Version)&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)ProbeVersion.g.cs" /></ItemGroup>
  </Target>
</Project>
